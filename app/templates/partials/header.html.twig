<header class="hero">
    <div class="container">
        <div class="header-content" style="display: flex; justify-content: space-between; align-items: center;">
            <div class="header-left">
                <h1>Gestion de Projets Simplifiée</h1>
                <p class="lead">Une solution complète pour gérer vos projets, vos équipes et vos délais.</p>
            </div>
            <div class="cta-buttons">
                {% if not is_granted('ROLE_USER') %}
                    <a href="{{ path('app_login') }}" class="btn btn-primary btn-lg">Se connecter</a>
                {% else %}
                    <a href="{{ path('app_logout') }}" class="btn btn-secondary btn-lg">Me déconnecter</a>
                {% endif %}
            </div>
        </div>
    </div>
</header>