{% extends 'base.html.twig' %}

{% block title %}Project index{% endblock %}

{% block body %}
    <h1>Project index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Title</th>
                <th>Description</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for project in projects %}
            <tr>
                <td>{{ project.id }}</td>
                <td>{{ project.title }}</td>
                <td>{{ project.description }}</td>
                <td>
                    <a href="{{ path('app_project_show', {'id': project.id}) }}"><button type="submit" class="btn btn-primary">Voir</button></a>
                    <a href="{{ path('app_project_edit', {'id': project.id}) }}"><button type="submit" class="btn btn-secondary">Modifier</button></a>
                    <form action="/project/{{ project.id }}/delete" method="POST"  onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce projet ?')"><button type="submit" class="btn btn-danger">Supprimer</button></form>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">Pas de projet en cours.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_project_create') }}">Créer un projet</a>
{% endblock %}
