<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Project PDF</title>
</head>
<body>
    <h1>{{ project.title }}</h1>
    <p>{{ project.description }}</p>
    <h2>Tasks</h2>
    <ul>
        {% for task in project.tasks %}
            <li>{{ task.title }} - {{ task.status.libelle }}</li>
        {% else %}
            <li>No tasks available.</li>
        {% endfor %}
    </ul>
</body>
</html>
{% block stylesheets %}
    <style>
        body {
            font-family: Arial, sans-serif;
        }
        h1 {
            color: #333;
        }
        p {
            font-size: 14px;
            line-height: 1.5;
        }
    </style>
{% endblock %}